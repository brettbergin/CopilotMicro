{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copilot-micro.local/contracts/bridge-v1.schema.json",
  "title": "Copilot Micro local bridge protocol version 1",
  "oneOf": [
    {
      "$ref": "#/$defs/actionRequest"
    },
    {
      "$ref": "#/$defs/actionResult"
    },
    {
      "$ref": "#/$defs/heartbeat"
    },
    {
      "$ref": "#/$defs/sessionEvent"
    },
    {
      "$ref": "#/$defs/sessionSnapshot"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "actionType": {
      "type": "string",
      "enum": [
        "session.openList",
        "session.create",
        "session.previous",
        "session.next",
        "session.archive",
        "session.cycleMode",
        "session.selectModel",
        "session.selectEffort",
        "session.voice",
        "session.cancelForeground",
        "composer.submit",
        "composer.focus",
        "picker.confirm",
        "picker.back",
        "permission.approveOnce",
        "permission.reject"
      ]
    },
    "actionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "messageType",
        "requestId",
        "instanceId",
        "sessionId",
        "generation",
        "contextRevision",
        "action"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "messageType": {
          "const": "action"
        },
        "requestId": {
          "$ref": "#/$defs/identifier"
        },
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "sessionId": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "$ref": "#/$defs/identifier"
        },
        "contextRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/actionType"
            },
            "permissionRequestId": {
              "$ref": "#/$defs/identifier"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": [
                      "permission.approveOnce",
                      "permission.reject"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "permissionRequestId"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "permissionRequestId"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "actionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "messageType",
        "requestId",
        "outcome",
        "message"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "messageType": {
          "const": "actionResult"
        },
        "requestId": {
          "$ref": "#/$defs/identifier"
        },
        "outcome": {
          "enum": [
            "accepted",
            "completed",
            "rejected",
            "failed"
          ]
        },
        "code": {
          "enum": [
            "focusConsumed",
            "paused",
            "disconnected",
            "unsynchronized",
            "staleInstance",
            "staleSession",
            "staleGeneration",
            "staleContext",
            "capabilityUnavailable",
            "capabilityBlocked",
            "capabilityUnknown",
            "invalidRequest",
            "permissionRequestNotPending",
            "permissionRequestNotVisible",
            "timedOut",
            "hostRejected",
            "transportFailure",
            "alreadyResolved",
            "duplicateRequest",
            "replayLedgerFull"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "unavailable",
            "blocked",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 512
        },
        "gapReference": {
          "type": "string",
          "maxLength": 128
        },
        "recoveryAction": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "pendingAttention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "kind"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "permission",
            "question",
            "elicitation",
            "planDecision"
          ]
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "messageType",
        "instanceId",
        "sessionId",
        "generation",
        "contextRevision"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "messageType": {
          "const": "heartbeat"
        },
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "sessionId": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "$ref": "#/$defs/identifier"
        },
        "contextRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "sessionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "messageType",
        "instanceId",
        "sessionId",
        "generation",
        "contextRevision",
        "reason"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "messageType": {
          "const": "sessionEvent"
        },
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "sessionId": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "$ref": "#/$defs/identifier"
        },
        "contextRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "enum": [
            "activity",
            "attention",
            "backgroundTasks",
            "capabilities",
            "hostError",
            "lifecycle",
            "mode",
            "model",
            "queue"
          ]
        }
      }
    },
    "sessionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "messageType",
        "instanceId",
        "sessionId",
        "generation",
        "contextRevision",
        "connection",
        "paused",
        "mode",
        "work",
        "pendingAttention",
        "attention",
        "capabilities",
        "hostCapabilities",
        "model",
        "compatibility"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "messageType": {
          "const": "sessionSnapshot"
        },
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "sessionId": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "$ref": "#/$defs/identifier"
        },
        "contextRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "connection": {
          "enum": [
            "connecting",
            "synchronizing",
            "ready",
            "reconnecting",
            "shuttingDown"
          ]
        },
        "paused": {
          "type": "boolean"
        },
        "mode": {
          "oneOf": [
            {
              "enum": [
                "default",
                "plan",
                "autopilot"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "known",
            "foregroundActive",
            "backgroundCount",
            "queuedCount"
          ],
          "properties": {
            "known": {
              "type": "boolean"
            },
            "foregroundActive": {
              "type": "boolean"
            },
            "backgroundCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "queuedCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            }
          }
        },
        "pendingAttention": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/pendingAttention"
          }
        },
        "attention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "known",
            "permissionCount",
            "otherCount"
          ],
          "properties": {
            "known": {
              "type": "boolean"
            },
            "permissionCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "otherCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "known": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "permissionCount": {
                    "const": 0
                  },
                  "otherCount": {
                    "const": 0
                  }
                }
              }
            }
          ]
        },
        "capabilities": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/actionType"
          },
          "additionalProperties": {
            "$ref": "#/$defs/capability"
          }
        },
        "hostCapabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "elicitation",
            "canvases",
            "mcpApps"
          ],
          "properties": {
            "elicitation": {
              "type": "boolean"
            },
            "canvases": {
              "type": "boolean"
            },
            "mcpApps": {
              "type": "boolean"
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "known",
            "modelId",
            "reasoningEffort",
            "contextTier",
            "availableModels"
          ],
          "properties": {
            "known": {
              "type": "boolean"
            },
            "modelId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128
            },
            "reasoningEffort": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 32
            },
            "contextTier": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 32
            },
            "availableModels": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "reasoningEffort",
                  "supportedReasoningEfforts"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "reasoningEffort": {
                    "type": "boolean"
                  },
                  "supportedReasoningEfforts": {
                    "type": "array",
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    }
                  }
                }
              }
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "cliVersion",
            "sdkVersion",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "qualifiedReadOnly",
                "unqualified"
              ]
            },
            "cliVersion": {
              "$ref": "#/$defs/identifier"
            },
            "sdkVersion": {
              "$ref": "#/$defs/identifier"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "visiblePermissionRequestId": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "category"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/identifier"
                },
                "category": {
                  "enum": [
                    "host",
                    "integration",
                    "protocolViolation",
                    "device"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "completionId": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
