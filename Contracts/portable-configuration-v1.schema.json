{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/github-app-micro2/contracts/portable-configuration-v1.schema.json",
  "title": "Copilot Micro portable configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "bindings",
    "lighting",
    "preferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "Copilot Micro"
    },
    "bindings": {
      "$ref": "configuration-v1.schema.json#/$defs/bindings"
    },
    "lighting": {
      "$ref": "configuration-v1.schema.json#/$defs/lighting"
    },
    "preferences": {
      "$ref": "configuration-v1.schema.json#/$defs/preferences"
    }
  }
}
