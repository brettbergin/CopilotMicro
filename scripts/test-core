#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
package="$root/Packages/CopilotMicroKit"

exec "$root/scripts/swiftpm" test \
    --package-path "$package" \
    --scratch-path "$package/.build" \
    --disable-xctest \
    --enable-swift-testing \
    "$@"
